# Copy to .r35.staging.env. It is intentionally ignored by Git.
# Create a dedicated, empty Supabase project for this target; do not put the
# historic shared project reference here.
R35_ENVIRONMENT=staging
R35_STAGING_PROJECT_REF=replace-with-dedicated-staging-project-ref
R35_STAGING_DB_PASSWORD=replace-with-staging-database-password
SUPABASE_URL=https://replace-with-dedicated-staging-project.supabase.co
SUPABASE_ANON_KEY=replace-with-staging-publishable-key
